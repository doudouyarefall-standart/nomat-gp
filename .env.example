# Variables d'environnement NOMAT GP — à configurer sur Vercel
# (Project Settings → Environment Variables)

# === BICTORYS (paiement) ===
# Clé API Bictorys — à récupérer sur votre compte marchand Bictorys
BICTORYS_API_KEY=your_bictorys_api_key_here

# URL de base Bictorys — sandbox pour tester, prod pour live
# Sandbox : https://sandbox-api.bictorys.com/v1
# Prod : https://api.bictorys.com/v1
BICTORYS_BASE_URL=https://api.bictorys.com/v1

# Secret webhook Bictorys — pour vérifier l'authenticité des notifications
BICTORYS_WEBHOOK_SECRET=your_webhook_secret_here

# === Admin ===
# Mot de passe admin (panneau ?admin=1)
ADMIN_PASSWORD=nomat2026

# === Site ===
# URL publique du site (pour les URLs de retour Bictorys)
NEXT_PUBLIC_SITE_URL=https://nomat-gp.vercel.app

# === Vercel KV (auto-configuré quand vous liez un KV store au projet) ===
# KV_REST_API_URL=auto-injected
# KV_REST_API_TOKEN=auto-injected
